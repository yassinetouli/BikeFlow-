        {
          "name": "01 - Créer une location (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rentals"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"userEmail\": \"salma@bikeflow.com\",\n  \"stationDepart\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"rentalId\", pm.response.json().id);",
                  "pm.test(\"Statut RESERVEE\", function () { pm.expect(pm.response.json().statut).to.eql(\"RESERVEE\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consulter la location (200)",
