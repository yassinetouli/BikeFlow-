									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"pm.test('immatriculation correcte', () => pm.expect(pm.response.json().immatriculation).to.eql(pm.collectionVariables.get('immatriculation')));"
								],
								"type": "text/javascript"
							}
						}
