						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"VELO\",\n  \"immatriculation\": \"{{immatriculation}}\",\n  \"autonomieKm\": 30,\n  \"statut\": \"EN_MAINTENANCE\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}", "host": ["{{baseUrl}}"], "path": ["api", "vehicles", "{{vehicleId}}"] }
					},
