							"listen": "test",
							"script": {
								"exec": [ "pm.test('404 Not Found', () => pm.response.to.have.status(404));" ],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Vehicles",
			"item": [
				{
					"name": "6. Créer un véhicule (201, statut par défaut DISPONIBLE)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"VELO\",\n  \"immatriculation\": \"{{immatriculation}}\",\n  \"autonomieKm\": 45\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/vehicles", "host": ["{{baseUrl}}"], "path": ["api", "vehicles"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('statut par défaut DISPONIBLE', () => pm.expect(body.statut).to.eql('DISPONIBLE'));",
									"pm.collectionVariables.set('vehicleId', body.id);",
									"console.log('vehicleId =', body.id);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "7. Lire le véhicule par id (200)",
