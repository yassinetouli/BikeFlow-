					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [ "pm.test('400 Bad Request', () => pm.response.to.have.status(400));" ],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "11a. Supprimer la station (204)",
					"request": {
						"method": "DELETE",
						"url": { "raw": "{{baseUrl}}/api/stations/{{stationId}}", "host": ["{{baseUrl}}"], "path": ["api", "stations", "{{stationId}}"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [ "pm.test('204 No Content', () => pm.response.to.have.status(204));" ],
