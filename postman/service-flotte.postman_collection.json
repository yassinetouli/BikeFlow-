{
	"info": {
		"_postman_id": "b1f3004e-0000-4a1e-8f9a-serviceflotte01",
		"name": "service-flotte",
		"description": "Tests REST du microservice Bike-Flow service-flotte (véhicules et stations). Importer dans Postman : File > Import > ce fichier.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8081" },
		{ "key": "stationId", "value": "" },
		{ "key": "vehicleId", "value": "" },
		{ "key": "immatriculation", "value": "V-TEST-001" }
	],
	"item": [
		{
			"name": "Stations",
			"item": [
				{
					"name": "1. Créer une station (201)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nom\": \"Station Mohammed V\",\n  \"adresse\": \"12 avenue Mohammed V\",\n  \"capacite\": 10,\n  \"placesLibres\": 6\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/stations", "host": ["{{baseUrl}}"], "path": ["api", "stations"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.collectionVariables.set('stationId', body.id);",
									"console.log('stationId =', body.id);"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "2. Lire la station par id (200)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/stations/{{stationId}}", "host": ["{{baseUrl}}"], "path": ["api", "stations", "{{stationId}}"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"pm.test('nom correct', () => pm.expect(pm.response.json().nom).to.eql('Station Mohammed V'));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "3. Lister les stations (200)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/stations", "host": ["{{baseUrl}}"], "path": ["api", "stations"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [ "pm.test('200 OK', () => pm.response.to.have.status(200));" ],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "4. Mettre à jour la station (200)",
					"request": {
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nom\": \"Station Mohammed V MAJ\",\n  \"adresse\": \"12 avenue Mohammed V\",\n  \"capacite\": 12,\n  \"placesLibres\": 8\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/stations/{{stationId}}", "host": ["{{baseUrl}}"], "path": ["api", "stations", "{{stationId}}"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"pm.test('placesLibres mises à jour', () => pm.expect(pm.response.json().placesLibres).to.eql(8));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "5a. Station invalide : placesLibres > capacite (400)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nom\": \"Station Invalide\",\n  \"adresse\": \"1 rue du Test\",\n  \"capacite\": 5,\n  \"placesLibres\": 9\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/stations", "host": ["{{baseUrl}}"], "path": ["api", "stations"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [ "pm.test('400 Bad Request', () => pm.response.to.have.status(400));" ],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "5b. Station invalide : capacite = 0 (400)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nom\": \"Station Invalide\",\n  \"adresse\": \"1 rue du Test\",\n  \"capacite\": 0,\n  \"placesLibres\": 0\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/stations", "host": ["{{baseUrl}}"], "path": ["api", "stations"] }
