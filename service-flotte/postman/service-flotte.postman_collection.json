{
  "info": {
    "name": "Bike-Flow - service-flotte (V1 + V2)",
    "description": "Tests REST du microservice service-flotte (stations et vehicules). Meme plan de tests que les collections service-locations et service-utilisateurs : cas valides, erreurs de validation (400), ressources inexistantes (404), regles de gestion (409) puis suppression. Pas de section Gateway : les routes de la flotte sont encore commentees dans Depot_config/service-flotte.properties. Importer dans Postman : File > Import > ce fichier.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "stationId",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "immatriculation",
      "value": "V-TEST-001"
    }
  ],
  "item": [
    {
      "name": "A - Cas valides",
      "item": [
        {
          "name": "01 - Créer une station (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Station Mohammed V\",\n  \"adresse\": \"12 avenue Mohammed V\",\n  \"capacite\": 10,\n  \"placesLibres\": 6\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"stationId\", pm.response.json().id);",
                  "pm.test(\"nom correct\", function () { pm.expect(pm.response.json().nom).to.eql(\"Station Mohammed V\"); });",
                  "pm.test(\"placesLibres = 6\", function () { pm.expect(pm.response.json().placesLibres).to.eql(6); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consulter la station (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stations/{{stationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stations",
                "{{stationId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"capacite = 10\", function () { pm.expect(pm.response.json().capacite).to.eql(10); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Lister les stations (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"liste non vide\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Mettre à jour la station (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
