                  "pm.test(\"type VELO\", function () { pm.expect(pm.response.json().type).to.eql(\"VELO\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Lister les véhicules (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
