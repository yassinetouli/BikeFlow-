          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"liste non vide\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Mettre à jour le véhicule (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles",
                "{{vehicleId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"VELO\",\n  \"immatriculation\": \"{{immatriculation}}\",\n  \"autonomieKm\": 30,\n  \"statut\": \"EN_MAINTENANCE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"autonomie mise à jour\", function () { pm.expect(pm.response.json().autonomieKm).to.eql(30); });",
                  "pm.test(\"statut mis à jour\", function () { pm.expect(pm.response.json().statut).to.eql(\"EN_MAINTENANCE\"); });"
                ]
              }
            }
          ]
        }
      ]
